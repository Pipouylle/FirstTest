{
    "appearance": {
        "transparency": {
            "enabled": false
        }
    },
    "background": {
        "wallpaperEnabled": true
    },
    "bar": {
        "persistent": true
    },
    "general": {
        "apps": {
            "audio": [
                "pavucontrol"
            ],
            "explorer": [
                "nautilus"
            ],
            "terminal": [
                "kitty"
            ]
        },
        "idle": {
            "lockBeforeSleep": true,
            "inhibitWhenAudio": true,
            "timeouts": [
                {
                    "timeout": 900,
                    "idleAction": "lock"
                },
                {
                    "timeout": 1200,
                    "idleAction": "dpms off",
                    "returnAction": "dpms on"
                },
                {
                    "timeout": 2700,
                    "idleAction": [
                        "systemctl",
                        "suspend-then-hibernate"
                    ]
                }
            ]
        }
    },
    "launcher": {
        "enabled": false,
        "favouriteApps": [
            "kitty",
            "nautilus",
            "firefox",
            "vesktop",
            "code"
        ],
        "showOnHover": false
    },
    "paths": {
        "wallpaperDir": "~/.cache/waypaper"
    }
}
