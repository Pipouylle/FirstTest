# Display Pokemon-colorscripts
# Project page: https://gitlab.com/phoneybadger/pokemon-colorscripts#on-other-distros-and-macos
#pokemon-colorscripts --no-title -s -r #without fastfetch
#pokemon-colorscripts --no-title -s -r | fastfetch -c $HOME/.config/fastfetch/config-pokemon.jsonc --logo-type file-raw --logo-height 10 --logo-width 5 --logo -

# Applique le colorscheme caelestia (genere a chaque changement de fond d'ecran).
# caelestia pousse ces sequences OSC vers les terminaux DEJA ouverts, mais n'a
# aucun moyen de les rejouer pour un terminal lance apres coup : sans ce cat, un
# nouveau terminal repart sur la palette par defaut. A garder avant fastfetch
# pour qu'il se dessine avec la bonne palette.
[[ -o interactive && -t 1 && -r ~/.local/state/caelestia/sequences.txt ]] && cat ~/.local/state/caelestia/sequences.txt

# fastfetch. Will be disabled if above colorscript was chosen to install
fastfetch -c $HOME/.config/fastfetch/config-compact.jsonc

# Set-up icons for files/directories in terminal using lsd
alias ls='lsd'
alias l='ls -l'
alias la='ls -a'
alias lla='ls -la'
alias lt='ls --tree'
alias clb="claude --dangerously-skip-permissions"
alias archwin='ssh -t timot@desktop-d08n7j2 wsl.exe -d archlinux --cd ~'
alias ssh="kitten ssh"
alias yac="cd ~/Document/Cour yazi"
alias zed='zeditor'
# Set-up FZF key bindings (CTRL R for fuzzy history finder)
source <(fzf --zsh)

HISTFILE=~/.zsh_history
HISTSIZE=10000
SAVEHIST=10000
setopt appendhistory

