#THIS MUST BE AT THE END OF THE FILE FOR SDKMAN TO WORK!!!
export SDKMAN_DIR="$HOME/.sdkman"
[[ -s "$HOME/.sdkman/bin/sdkman-init.sh" ]] && source "$HOME/.sdkman/bin/sdkman-init.sh"
# Avoid "'xterm-kitty': unknown terminal type." when i try to clear
export TERM=xterm
alias gem='STTY_SIZE=80x24 TERM=vt100 gemini gemini'


# Added by Antigravity CLI installer
export PATH="/home/timothe/.local/bin:$PATH"
export PATH="/home/timothe/.local/bin:$PATH"

# agy et claude : tokens dans le groupe « Tokens CLI » de la base KeePassXC, mot de passe maître
# demandé par appli, valable 10 min après sa dernière utilisation (voir ~/.local/bin/keepass-tokens).
# Contourner : `command agy`, `command claude` (ex. `command claude setup-token`).
agy() { keepass-tokens agy "$@"; }
claude() { keepass-tokens claude "$@"; }
# chromium : toujours le Chromium du compte dédié ; /usr/bin/chromium lancé en direct
# ouvrirait un profil dans ~/.config/chromium, lisible par la session
alias chromium=chromium-sbx

export SSH_AUTH_SOCK="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/ssh-agent.socket"

