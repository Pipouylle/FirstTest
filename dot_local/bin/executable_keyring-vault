#!/usr/bin/env bash
# keyring-vault : Gestionnaire de tokens API sécurisés via GNOME Keyring et stockage éphémère en RAM
set -euo pipefail

UID_NUM=$(id -u)
SECRETS_DIR="/run/user/${UID_NUM}/secrets"
CLAUDE_FILE="$HOME/.claude/.credentials.json"
CLAUDE_RAM="$SECRETS_DIR/claude-credentials.json"
AGY_FILE="$HOME/.gemini/antigravity-cli/antigravity-oauth-token"
AGY_RAM="$SECRETS_DIR/antigravity-oauth-token"

ensure_secrets_dir() {
    if [[ ! -d "$SECRETS_DIR" ]]; then
        mkdir -p "$SECRETS_DIR"
        chmod 700 "$SECRETS_DIR"
    fi
}

init_vault() {
    echo "==> Initialisation du coffre de tokens dans GNOME Keyring..."
    ensure_secrets_dir

    # 1. Sauvegarde et injection du token Claude
    if [[ -f "$CLAUDE_FILE" && ! -L "$CLAUDE_FILE" ]]; then
        echo "--> Migration du token Claude vers le Keyring..."
        secret-tool store --label="Claude Code Credentials" service claude_code user "$USER" < "$CLAUDE_FILE"
        cp "$CLAUDE_FILE" "$CLAUDE_RAM"
        chmod 600 "$CLAUDE_RAM"
        cp "$CLAUDE_FILE" "${CLAUDE_FILE}.bak"
        ln -sf "$CLAUDE_RAM" "$CLAUDE_FILE"
        echo "    ✓ Claude migré en RAM & lié au trousseau."
    elif [[ -L "$CLAUDE_FILE" ]]; then
        echo "    [i] Claude est déjà lié vers la RAM."
    fi

    # 2. Sauvegarde et injection du token Antigravity (Agy)
    if [[ -f "$AGY_FILE" && ! -L "$AGY_FILE" ]]; then
        echo "--> Migration du token Antigravity vers le Keyring..."
        secret-tool store --label="Antigravity OAuth Token" service antigravity_cli user "$USER" < "$AGY_FILE"
        cp "$AGY_FILE" "$AGY_RAM"
        chmod 600 "$AGY_RAM"
        cp "$AGY_FILE" "${AGY_FILE}.bak"
        ln -sf "$AGY_RAM" "$AGY_FILE"
        echo "    ✓ Antigravity migré en RAM & lié au trousseau."
    elif [[ -L "$AGY_FILE" ]]; then
        echo "    [i] Antigravity est déjà lié vers la RAM."
    fi

    echo "==> Configuration terminée avec succès !"
}

unlock_vault() {
    ensure_secrets_dir

    # Déverrouiller Claude si absent de la RAM
    if [[ ! -s "$CLAUDE_RAM" ]]; then
        CLAUDE_DATA=$(secret-tool lookup service claude_code user "$USER" 2>/dev/null || true)
        if [[ -n "$CLAUDE_DATA" ]]; then
            echo -n "$CLAUDE_DATA" > "$CLAUDE_RAM"
            chmod 600 "$CLAUDE_RAM"
        fi
    fi
    if [[ ! -L "$CLAUDE_FILE" && -s "$CLAUDE_RAM" ]]; then
        mkdir -p "$(dirname "$CLAUDE_FILE")"
        [[ -f "$CLAUDE_FILE" ]] && cp "$CLAUDE_FILE" "${CLAUDE_FILE}.bak"
        ln -sf "$CLAUDE_RAM" "$CLAUDE_FILE"
    fi

    # Déverrouiller Agy si absent de la RAM
    if [[ ! -s "$AGY_RAM" ]]; then
        AGY_DATA=$(secret-tool lookup service antigravity_cli user "$USER" 2>/dev/null || true)
        if [[ -n "$AGY_DATA" ]]; then
            echo -n "$AGY_DATA" > "$AGY_RAM"
            chmod 600 "$AGY_RAM"
        fi
    fi
    if [[ ! -L "$AGY_FILE" && -s "$AGY_RAM" ]]; then
        mkdir -p "$(dirname "$AGY_FILE")"
        [[ -f "$AGY_FILE" ]] && cp "$AGY_FILE" "${AGY_FILE}.bak"
        ln -sf "$AGY_RAM" "$AGY_FILE"
    fi
}

sync_vault() {
    # Si les tokens ont été rafraîchis par l'application dans la RAM, les remettre dans le trousseau
    if [[ -s "$CLAUDE_RAM" ]]; then
        secret-tool store --label="Claude Code Credentials" service claude_code user "$USER" < "$CLAUDE_RAM" 2>/dev/null || true
    fi
    if [[ -s "$AGY_RAM" ]]; then
        secret-tool store --label="Antigravity OAuth Token" service antigravity_cli user "$USER" < "$AGY_RAM" 2>/dev/null || true
    fi
}

lock_vault() {
    sync_vault
    rm -f "$CLAUDE_RAM" "$AGY_RAM"
    secret-tool lock --collection=login 2>/dev/null || true
    echo "==> Coffre verrouillé : les tokens ont été effacés de la mémoire vive (RAM)."
}

status_vault() {
    echo "--- Statut du coffre de tokens ---"
    if [[ -s "$CLAUDE_RAM" ]]; then
        echo "Claude Token      : [DÉVERROUILLÉ] (présent en RAM)"
    else
        echo "Claude Token      : [VERROUILLÉ] (absent de la RAM)"
    fi

    if [[ -s "$AGY_RAM" ]]; then
        echo "Antigravity Token : [DÉVERROUILLÉ] (présent en RAM)"
    else
        echo "Antigravity Token : [VERROUILLÉ] (absent de la RAM)"
    fi
}

case "${1:-status}" in
    init|setup)
        init_vault
        ;;
    unlock)
        unlock_vault
        ;;
    lock)
        lock_vault
        ;;
    sync)
        sync_vault
        ;;
    status)
        status_vault
        ;;
    *)
        echo "Usage: $0 {init|unlock|lock|sync|status}"
        exit 1
        ;;
esac
