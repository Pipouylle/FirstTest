#!/usr/bin/env python3
import sys
import os

GLOBAL_FLAGS = {
    "--silent", "-s",
    "--noautomount",
    "--no-audio-processing",
    "--no-fullscreen-pause",
    "--fullscreen-pause-only-active",
    "--disable-particles",
    "--disable-mouse",
    "--disable-parallax",
    "--list-properties",
    "--dump-structure",
    "-h", "--help"
}

GLOBAL_OPTIONS_WITH_ARGS = {
    "--volume", "-v",
    "--fps", "-f",
    "--layer",
    "--screenshot",
    "--screenshot-delay",
    "--assets-dir"
}

def main():
    new_args = []
    seen_globals = set()
    
    args = sys.argv[1:]
    i = 0
    while i < len(args):
        arg = args[i]
        
        # Skip background execution symbol if waypaper appends it
        if arg == "&":
            i += 1
            continue
            
        if arg in GLOBAL_FLAGS:
            if arg not in seen_globals:
                seen_globals.add(arg)
                new_args.append(arg)
            i += 1
        elif arg in GLOBAL_OPTIONS_WITH_ARGS:
            if arg not in seen_globals:
                seen_globals.add(arg)
                new_args.append(arg)
                if i + 1 < len(args):
                    new_args.append(args[i + 1])
            i += 2
        else:
            new_args.append(arg)
            i += 1

    # Execute the real binary with deduplicated arguments
    os.execv("/usr/bin/linux-wallpaperengine", ["/usr/bin/linux-wallpaperengine"] + new_args)

if __name__ == "__main__":
    main()
